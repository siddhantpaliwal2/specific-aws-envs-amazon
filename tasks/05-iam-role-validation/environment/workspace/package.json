{
    "name": "meteringco-backend",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "start:influx": "sudo docker start influxdb",
        "pre-commit": "npm run lint",
        "pre-push": "npm run build && npm run test",
        "stop:influx": "sudo docker stop influxdb",
        "setup:influx": "sudo docker pull influxdb:2.6.0 && sudo docker run --name influxdb -p 8086:8086 influxdb:2.6.0",
        "setup:redis": "sudo docker run --name bullmq-redis -p 6379:6379 -d redis redis-server --save 60 1 --loglevel warning",
        "stop:redis": "sudo docker stop bullmq-redis",
        "start:redis": "sudo docker start bullmq-redis",
        "start:dev": "nest start --watch --entryFile genericExpressEnv",
        "prebuild": "rimraf dist",
        "cleanup": "kind delete cluster && docker image rm meteringco-agent-transformer:local",
        "cleanup:integration": "npm run stop:influx && npm run stop:redis",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "deploy:dev": "sls deploy --stage=dev",
        "deploy:prod": "sls deploy --stage=prod",
        "start:generic": "node dist/genericExpressEnv",
        "start:lambda": "node dist/lambda",
        "generate:private:specification": "node dist/openApiSpecGenerator && redoc-cli bundle -o ./docs/private_api.html ./docs/open-api-private-spec.json",
        "generate:public:specification": "node dist/openApiPublicSpecGenerator && redoc-cli bundle --options.theme.shape.borderRadius=0 --options.hideDownloadButton=true --options.theme.typography.fontSize=14px -o ./docs/public_api.html ./docs/open-api-public-spec.json",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --quiet",
        "prepare": "husky install",
        "prepare:integration": "npm run start:influx && npm run start:redis",
        "prepare:kindcluster": "kind create cluster --config ./resources/kind-config.yaml && kubectl apply -f https://raw.githubusercontent.com/kubernetes/ingress-nginx/main/deploy/static/provider/kind/deploy.yaml &&  kubectl wait --namespace ingress-nginx --for=condition=ready pod --selector=app.kubernetes.io/component=controller --timeout=90s&& helm repo add bitnami https://charts.bitnami.com/bitnami && helm install my-release bitnami/redis && export REDIS_PASSWORD=$(kubectl get secret --namespace default my-release-redis -o jsonpath=\"{.data.redis-password}\" | base64 -d) && npm run build-docker-integration && sed -i \"s/REDIS_PASSWORD=.*/REDIS_PASSWORD=$REDIS_PASSWORD/\" .env && kind load docker-image meteringco-agent-transformer:local && kubectl apply -f ./resources/local/deployment_local.yml && export POD=$(kubectl get pod -l app=meteringco-agent-transformer -o jsonpath=\"{.items[0].metadata.name}\") ",
        "test": "jest --config ./jest.unit.config.json",
        "test:ci": "jest --config ./jest.unit.config.json --forceExit",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "test:api": "jest --config ./test/jest-api.json",
        "test:db": "jest --config ./test/jest-db.json",
        "test:local:integration": "jest --config ./integration/jest.local.config.json",
        "test:ci:integration": "jest --config ./integration/jest.ci.config.json",
        "deploy:specification": "node docs/deployDocument.js",
        "build-docker": "docker build -t meteringco-agent-transformer --no-cache .",
        "build-docker-integration": "docker build -t meteringco-agent-transformer:local --no-cache .",
        "development:refresh:integration": "npm run build-docker-integration && kind load docker-image meteringco-agent-transformer:local && kubectl rollout restart deployment meteringco-agent-transformer",
        "run-docker": "docker run -p 3000:3000 meteringco-agent-transformer",
        "push-image-dev": "docker tag meteringco-agent-transformer 123456789012.dkr.ecr.us-east-1.amazonaws.com/meteringco-agent-transformer:latest && docker push 123456789012.dkr.ecr.us-east-1.amazonaws.com/meteringco-agent-transformer:latest",
        "push-image-prod": "docker tag meteringco-agent-transformer 123456789012.dkr.ecr.us-east-1.amazonaws.com/meteringco-agent-transformer:prod && docker push 123456789012.dkr.ecr.us-east-1.amazonaws.com/meteringco-agent-transformer:prod"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-cloudtrail": "^3.437.0",
        "@aws-sdk/client-cloudwatch": "^3.437.0",
        "@aws-sdk/client-cost-explorer": "^3.437.0",
        "@aws-sdk/client-ec2": "^3.437.0",
        "@aws-sdk/client-iam": "^3.437.0",
        "@aws-sdk/client-pricing": "^3.437.0",
        "@aws-sdk/client-s3": "^3.437.0",
        "@aws-sdk/client-ses": "^3.245.0",
        "@aws-sdk/client-ssm": "^3.437.0",
        "@aws-sdk/credential-providers": "^3.437.0",
        "@aws-sdk/hash-node": "^3.370.0",
        "@aws-sdk/lib-storage": "^3.437.0",
        "@aws-sdk/protocol-http": "^3.370.0",
        "@aws-sdk/s3-request-presigner": "^3.437.0",
        "@aws-sdk/types": "^3.433.0",
        "@aws-sdk/url-parser": "^3.370.0",
        "@aws-sdk/util-format-url": "^3.433.0",
        "@azure/arm-compute": "^21.2.0",
        "@azure/arm-consumption": "^9.2.0",
        "@azure/identity": "^3.3.2",
        "@influxdata/influxdb-client": "^1.33.2",
        "@influxdata/influxdb-client-apis": "^1.33.2",
        "@kubernetes/client-node": "^0.19.0",
        "@metinseylan/nestjs-opentelemetry": "^3.0.0",
        "@nestjs/bull": "^10.0.1",
        "@nestjs/common": "^10.2.7",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.2.7",
        "@nestjs/jwt": "^10.1.1",
        "@nestjs/mapped-types": "^2.0.2",
        "@nestjs/passport": "^10.0.2",
        "@nestjs/platform-express": "^10.2.7",
        "@nestjs/schedule": "^4.0.0",
        "@nestjs/swagger": "^7.1.14",
        "@nestjs/typeorm": "^10.0.0",
        "@opentelemetry/auto-instrumentations-node": "^0.39.4",
        "@opentelemetry/exporter-collector": "^0.25.0",
        "@opentelemetry/exporter-metrics-otlp-http": "0.43.0",
        "@opentelemetry/exporter-prometheus": "^0.44.0",
        "@opentelemetry/exporter-trace-otlp-http": "0.43.0",
        "@opentelemetry/instrumentation-nestjs-core": "^0.33.2",
        "@opentelemetry/resources": "^1.17.1",
        "@opentelemetry/sdk-node": "0.43.0",
        "@opentelemetry/semantic-conventions": "^1.17.1",
        "@opentelemetry/tracing": "^0.24.0",
        "@twosdai/microinvoice": "^2.7.0",
        "@types/multer": "^1.4.9",
        "@vendia/serverless-express": "^4.10.4",
        "aws-lambda": "^1.0.7",
        "bull": "^4.11.4",
        "cache-manager": "^4.1.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "cross-fetch": "^4.0.0",
        "currency-symbol-map": "^5.1.0",
        "express": "^4.18.2",
        "express-oauth2-jwt-bearer": "^1.6.0",
        "express-openid-connect": "^2.17.0",
        "express-session": "^1.17.3",
        "js-yaml": "^4.1.0",
        "jwks-rsa": "^3.1.0",
        "kafkajs": "^2.2.4",
        "lodash.chunk": "^4.2.0",
        "lodash.flattendeep": "^4.4.0",
        "lodash.isequal": "^4.5.0",
        "lodash.merge": "^4.6.2",
        "lodash.mergewith": "^4.6.2",
        "lodash.pickby": "^4.6.0",
        "nestjs-otel": "^5.1.5",
        "node-fetch": "^3.3.2",
        "node-snappy": "^0.1.4",
        "openid-client": "^5.6.1",
        "passport": "^0.6.0",
        "passport-jwt": "^4.0.1",
        "pdfkit": "^0.13.0",
        "protobufjs": "^7.2.5",
        "redis": "^4.6.10",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^5.0.5",
        "rxjs": "^7.8.1",
        "serialize-error": "^8.1.0",
        "snappy": "^7.2.2",
        "snappy-stream": "^3.0.2",
        "snappyjs": "^0.7.0",
        "stripe": "^10.8.0",
        "swagger-ui-express": "^5.0.0",
        "taxjar": "^4.1.0"
    },
    "devDependencies": {
        "@aws-sdk/client-lambda": "^3.437.0",
        "@golevelup/ts-jest": "^0.4.0",
        "@nestjs/cli": "^10.2.0",
        "@nestjs/schematics": "^10.0.2",
        "@nestjs/testing": "^10.2.7",
        "@types/aws-lambda": "^8.10.125",
        "@types/bull": "^4.10.0",
        "@types/cache-manager": "^4.0.4",
        "@types/cron": "^2.0.1",
        "@types/express": "^4.17.20",
        "@types/jest": "29.5.6",
        "@types/node": "^20.8.9",
        "@types/supertest": "^2.0.15",
        "@typescript-eslint/eslint-plugin": "^6.9.0",
        "@typescript-eslint/parser": "^6.9.0",
        "aws-sdk-client-mock": "^3.0.0",
        "eslint": "^8.52.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.1",
        "expect": "^29.7.0",
        "husky": "^8.0.3",
        "jest": "^29.7.0",
        "prettier": "^3.0.3",
        "serverless": "^3.36.0",
        "serverless-dotenv-plugin": "^6.0.0",
        "serverless-offline": "^13.2.0",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.3",
        "ts-jest": "29.1.1",
        "ts-loader": "^9.5.0",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "4.2.0",
        "typescript": "^5.2.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
