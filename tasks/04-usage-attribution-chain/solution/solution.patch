+export const getInstanceTags = async (region, creds, instanceId: string): Promise<Record<string, string>> => {
+    const ec2Client = new EC2Client({ region, credentials: creds });
+    const response = await ec2Client.send(new DescribeInstancesCommand({ InstanceIds: [instanceId] }));
+    const tags: Record<string, string> = {};
+    (response?.Reservations ?? []).forEach(({ Instances }) => {
+        (Instances ?? []).forEach((instance) => {
+            (instance.Tags ?? []).forEach(({ Key, Value }) => {
+                if (Key) {
+                    tags[Key] = Value ?? '';
+                }
+            });
+        });
+    });
+    return tags;
+};
